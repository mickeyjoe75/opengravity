# OpenGravity Environment Configuration

# ---------------------------------------------------------
# Default Configuration
# ---------------------------------------------------------
# Set your preferred default provider and model
OPENGRAVITY_DEFAULT_PROVIDER="openai"
OPENGRAVITY_DEFAULT_MODEL="gpt-4o"

# ---------------------------------------------------------
# Provider API Keys
# ---------------------------------------------------------

# OpenAI API Key
OPENAI_API_KEY="your_openai_api_key_here"

# DeepSeek API Key (e.g. for deepseek-chat)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Moonshot AI API Key (e.g. for moonshot-v1-8k)
KIMI_API_KEY="your_kimi_api_key_here"

# Zhipu AI API Key (e.g. for glm-4)
GLM_API_KEY="your_glm_api_key_here"

# Alibaba Cloud API Key (e.g. for qwen-max)
QWEN_API_KEY="your_qwen_api_key_here"

# Mistral AI API Key
MISTRAL_API_KEY="your_mistral_api_key_here"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key
GROQ_API_KEY="your_groq_api_key_here"

# Together AI API Key
TOGETHER_API_KEY="your_together_api_key_here"

# OpenRouter API Key
OPENROUTER_API_KEY="your_openrouter_api_key_here"
